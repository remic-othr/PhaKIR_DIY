# Registry base URL for API (_catalog etc.)
PH_URL=https://submission.domain.de/
# Registry for docker login/pulls
PH_REGISTRY=submission.domain.de/
# Credentials
PH_USER=your-username
PH_PASS=your-password

# Local root directory for evaluation
PH_ROOT=./myChallenge

# Timeout for docker pull in seconds
PH_PULL_TIMEOUT=300
