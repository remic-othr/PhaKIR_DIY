# Authentik API
AUTH_BASE_URL=https://auth.domain.de
AUTH_TOKEN=__paste_personal_access_token__
AUTHENTIK_GROUP=phakir Users

# SMTP
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=__smtp_password__
MAIL_ADDRESS=no-reply@example.com

# Storage for saved PDFs/images
DOCUMENT_PATH=/var/app/review_docs

ATTR_UPLOAD_KEY=verification_file
